{
  "manifest_version": 3,
  "name": "Загрузчик Яндекс Диска и ВК",
  "version": "1.5.16",
  "description": "Скачивание папок Яндекс Диска, фотографий и выбранных видео диалогов ВК с продолжением без дубликатов.",
  "minimum_chrome_version": "124",
  "permissions": [
    "downloads",
    "activeTab",
    "scripting",
    "offscreen",
    "power",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://cloud-api.yandex.net/*",
    "https://downloader.disk.yandex.ru/*",
    "https://*.storage.yandex.net/*",
    "https://vk.ru/*",
    "https://vk.com/*",
    "https://www.vk.ru/*",
    "https://www.vk.com/*",
    "https://*.vkuserphoto.ru/*",
    "https://*.vkuserphoto.com/*",
    "https://*.userapi.com/*",
    "https://*.vkusercontent.ru/*",
    "https://*.okcdn.ru/*",
    "https://*.vkuser.net/*"
  ],
  "action": {
    "default_title": "Скачать с Яндекс Диска или из диалога ВК",
    "default_popup": "app.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
